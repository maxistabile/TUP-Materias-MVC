@model IEnumerable<TUP_Materias.Models.Materia>

@{
    ViewData["Title"] = "Listado de Materias";
}

<div class="container mt-4">
    <h1 class="mb-4">Materias de la TUP</h1>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Materia</th>
                <th>Profesor a Cargo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var materia in Model)
            {
                <tr>
                    <td><strong>@materia.Nombre</strong></td>
                    <td>@materia.ProfesorAsignado.Apellido, @materia.ProfesorAsignado.Nombre</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@materia.Id" class="btn btn-primary btn-sm">Ver Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>